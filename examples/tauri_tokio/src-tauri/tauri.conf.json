{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flow Reload Lab",
  "version": "0.1.0",
  "identifier": "com.reactorreloader.tauri_tokio",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    },
    "windows": [
      {
        "title": "Flow Reload Lab — Rust hot reload",
        "width": 1180,
        "height": 850,
        "minWidth": 940,
        "minHeight": 720
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
